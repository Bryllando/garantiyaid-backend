NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://garantiyaid_app:replace-with-a-strong-password@localhost:5432/garantiyaid
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
# Local/Postman development convenience. Change to 15m before production deployment.
JWT_ACCESS_EXPIRES_IN=24h
JWT_ISSUER=garantiyaid-api
JWT_AUDIENCE=garantiyaid-staff
FIELD_ENCRYPTION_KEY=replace-with-exactly-64-hexadecimal-characters

# Set to the exact number of trusted reverse proxies in production.
TRUST_PROXY_HOPS=0
ENFORCE_HTTPS=false

# Authentication abuse protection
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
API_RATE_LIMIT_PER_15_MINUTES=300
AUTH_RATE_LIMIT_PER_15_MINUTES=10
BIOMETRIC_RATE_LIMIT_PER_15_MINUTES=30
REPORT_RATE_LIMIT_PER_15_MINUTES=100
NOTIFICATION_RATE_LIMIT_PER_15_MINUTES=60
CHATBOT_RATE_LIMIT_PER_15_MINUTES=30

# Phase 10 controlled-chatbot collection and abuse limits.
CHATBOT_MAX_MESSAGES_PER_SESSION=100
CHATBOT_SESSION_MAX_HOURS=24
CHATBOT_RETENTION_DAYS=90

# Optional AI-assisted wording for approved public guidance. The raw user
# message and all personal records are never sent to this external provider.
OPENROUTER_API_KEY=

# Successful mutation responses are replayable for this many hours.
IDEMPOTENCY_TTL_HOURS=24

# Test GUID note: a5d97a8c-d6ca-4cc1-9f22-b142d7e3e75f
# Test GUID note: b6815b1c-cc37-4e03-badd-4b31ffde9689
# Test GUID note: c42437c4-abf3-44ac-8216-4c0fe0841f48
# Test GUID note: 789db9ea-417c-4ad6-801e-41d8635a7811

# Test GUID note: af02c7b6-8338-4e0f-84f3-218db62ef3b7
# Test GUID note: 6dff7621-0019-40b6-b7fd-b244c8414b82
# Test GUID note: 280b0a94-53bf-4e44-9f90-6f9c53f2ecd0
# Test GUID note: f1748de9-1148-41ac-8879-81bb711f8cba
# Test GUID note: 04bb0a0d-8219-4d67-a115-149bb90d6bdf

# Local AI runs DeepFace ArcFace with anti-spoofing through docker-compose.biometric.yml.
# Production validation requires the same API behind authenticated HTTPS.
BIOMETRIC_PROCESSOR_MODE=REMOTE
BIOMETRIC_SERVICE_URL=http://127.0.0.1:5005
BIOMETRIC_SERVICE_API_KEY=replace-with-at-least-32-random-characters
BIOMETRIC_REQUEST_TIMEOUT_MS=30000
# Calibrate this cosine-similarity threshold with representative local captures.
BIOMETRIC_MATCH_THRESHOLD=0.50
BIOMETRIC_LIVENESS_THRESHOLD=0.80

# Phase 9 notification processing. SMS_PROVIDER_MODE is intentionally limited
# to SIMULATED and never contacts a real recipient or external SMS gateway.
REDIS_URL=redis://127.0.0.1:6379
NOTIFICATION_QUEUE_NAME=garantiyaid-notifications
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_BACKOFF_MS=1000
NOTIFICATION_BATCH_MAX_SIZE=100
NOTIFICATION_MAX_DELAY_DAYS=30
SMS_PROVIDER_MODE=SIMULATED
SMS_SIMULATED_FAILURE_MODE=NONE
# Placeholders only: keep local Gmail secrets in .env and deployed values in Railway Variables.
EMAIL_PROVIDER_MODE=DISABLED
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=GarantiyAid Security
PUBLIC_APP_URL=http://localhost:5173
EMAIL_REQUEST_TIMEOUT_MS=10000
DISTRIBUTION_REMINDER_LEAD_MINUTES=1440

# Used only once by `npm run prisma:seed`. Never commit real values.
INITIAL_ADMIN_EMPLOYEE_ID=ADMIN-001
INITIAL_ADMIN_USERNAME=system.admin
INITIAL_ADMIN_FULL_NAME=Initial System Administrator
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
