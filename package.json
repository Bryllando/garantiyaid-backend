{
  "name": "garantiyaid-backend",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker:notifications": "node src/workers/notification.worker.js",
    "biometric:ai:up": "docker compose -f docker-compose.biometric.yml up -d",
    "biometric:ai:down": "docker compose -f docker-compose.biometric.yml down",
    "biometric:ai:logs": "docker compose -f docker-compose.biometric.yml logs -f biometric-ai",
    "verify:workflow": "node scripts/verify-program-enrollment-workflow.js",
    "verify:distribution": "npm run verify:distribution:setup && npm run verify:distribution:slots && npm run verify:distribution:allocations && npm run verify:distribution:schedules && npm run verify:distribution:claims && npm run verify:wallet && npm run verify:biometric:simulated",
    "verify:distribution:setup": "node scripts/verify-distribution-setup.js",
    "verify:distribution:slots": "node scripts/verify-distribution-slots.js",
    "verify:distribution:allocations": "node scripts/verify-distribution-allocations.js",
    "verify:distribution:schedules": "node scripts/verify-distribution-schedules.js",
    "verify:distribution:claims": "node scripts/verify-distribution-claims.js",
    "verify:wallet": "node scripts/verify-simulated-wallet.js",
    "verify:biometric": "node scripts/verify-biometric.js",
    "verify:biometric:simulated": "node scripts/verify-biometric-simulated.js",
    "verify:biometric:remote": "node scripts/verify-biometric-remote-captures.js",
    "verify:notifications": "node scripts/verify-notifications.js",
    "verify:chatbot": "node --test test/chatbot.test.js",
    "verify:assistant": "node scripts/verify-assistant.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "security:static": "node scripts/security-static-check.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:static && npm run test && npm run prisma:validate && npm run security:audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openai": "^7.9.0",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
